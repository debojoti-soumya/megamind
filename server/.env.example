# --- Claude (orchestrator) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Qwen-VL reader + enricher (any OpenAI-compatible endpoint: vLLM, Together, OpenRouter, DashScope) ---
READER_BASE_URL=http://localhost:8001/v1
READER_API_KEY=none
READER_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# caption = return stored text only; vlm = send retrieved frames to READER_BASE_URL; local = SmolVLM on CPU
READER_PROVIDER=caption
READER_MAX_FRAMES=4
ENRICH_BASE_URL=                # set to enable VLM captions/OCR (ENRICH_PROVIDER=auto)
ENRICH_MODEL=

# --- Embeddings ---
EMBED_PROVIDER=openai          # openai | voyage | local | mock
EMBED_MODEL=text-embedding-3-small
LOCAL_TEXT_MODEL=BAAI/bge-small-en-v1.5
IMAGE_EMBED_PROVIDER=siglip    # siglip | mock | none
IMAGE_EMBED_MODEL=ViT-B-16-SigLIP
IMAGE_EMBED_PRETRAINED=webli
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Speech ---
STT_PROVIDER=openai            # openai | deepgram | mock
TTS_PROVIDER=openai            # openai | elevenlabs | mock
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Storage ---
STORE_BACKEND=memory           # memory | lancedb
LANCEDB_PATH=./data/lancedb
THUMB_DIR=./data/thumbs
CHUNK_DIR=./data/chunks         # cold tier: AV1 chunk per episode (needs ffmpeg with libsvtav1 or libaom-av1)
HOT_RETENTION_H=72
COLD_RETENTION_DAYS=100
COLD_WIDTH=960
COLD_CRF=50
AGE_INTERVAL_S=3600
AUDIO_DIR=./data/audio

# --- Filter ---
FILTER_MIN_GAP_S=2.0
FILTER_DHASH_MAX_DISTANCE=6
FILTER_DHASH_WINDOW_S=30
FILTER_MIN_LUMA=20
FILTER_MIN_SHARPNESS=15
FILTER_HEARTBEAT_S=30
FILTER_SPEECH_MERGE_S=10        # speech this soon after a kept frame is appended to it
FILTER_POSE_YAW_DEG=25
FILTER_POSE_MOVE_M=0.75
FILTER_BUDGET_PER_MIN=6        # 0 disables the cap
FILTER_BUDGET_BURST=6

# --- Episodes ---
EPISODE_GAP_S=120
EPISODE_SPLIT_SIM=0.70
EPISODE_REJOIN_SIM=0.80
EPISODE_MOVE_M=3.0

# --- Search ---
SEARCH_W_BM25=1.0
SEARCH_W_TEXT=1.0
SEARCH_W_IMAGE=1.5
SEARCH_PER_EPISODE_CAP=3
