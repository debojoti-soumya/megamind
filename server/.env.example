# --- Auth (public deployments, e.g. deploy/modal_app.py) ---
API_TOKEN=                     # empty = no auth; set = every route needs "Authorization: Bearer <token>" or ?token=
WARMUP=true                    # background warmup at startup (free/tiny calls) so the first question after a cold start is fast
WARMUP_TIMEOUT_S=20            # per warmup step; failures are only logged

# --- Claude (orchestrator) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5           # 1.6 s/turn live; claude-haiku-4-5 ~1.2 s, claude-opus-5-5 ~2.2 s (p95 5.5 s)
CLAUDE_TIMEOUT_S=30             # per Anthropic call; SDK retries CLAUDE_MAX_RETRIES times on 429/5xx
CLAUDE_MAX_RETRIES=2
CLAUDE_PROMPT_CACHE=true       # cache tools + the clock-free system prompt and the session history across calls/turns; false = the pre-caching request bodies
RECALL_PREFETCH=true           # start recall_memory on the raw question during Claude's first call; reused if Claude's query matches
RECALL_FIRST=true              # standalone recall questions skip that first call: the prefetch is Claude's first tool result
NOW_FAST_PATH=true             # "right now" questions with live frames: no retrieval, Claude gets only the newest live frames + speech
CLAUDE_ROUTE_FAST=false        # opt-in: live / short standalone recall questions use CLAUDE_FAST_MODEL instead of CLAUDE_MODEL
CLAUDE_FAST_MODEL=claude-haiku-5-5
STREAM_REPLAY_BUDGET_S=0.15    # max wait for replay_url lookups before the stream's `retrieval` event goes out (final always has them)
CHAT_DEFAULT_DEVICE=           # demo convenience: "latest" = a chat device_id with no memories searches the most recently active device instead (reported as device_id_used)
WEARER_TZ=America/Los_Angeles   # local time + tz given to Claude so "this morning" resolves correctly

# --- VLM reader + enricher (any OpenAI-compatible endpoint; see docs/resources.md) ---
# Hackathon default: Sail Research (credits), Gemma 4 31B with image input. Put the team Sail key in READER_API_KEY;
# READER_BASE_URL stays https://api.sailresearch.com/v1. Without a key the reader is captions-only (no images).
# Alternatives: self-hosted vLLM on Modal (Qwen/Qwen2.5-VL-7B-Instruct), Together, OpenRouter, DashScope.
READER_BASE_URL=https://api.sailresearch.com/v1
READER_API_KEY=
READER_MODEL=google/gemma-4-31B-it     # asap window, image input. Qwen/Qwen3.6-35B-A3B is flex-only on Sail (400 on chat)
READER_FALLBACK_MODEL=nvidia/Gemma-4-31B-IT-NVFP4   # hedge for a slow primary; also takes over after a 429/503/timeout
READER_PROVIDER=auto                    # auto (Claude reads the images iff ANTHROPIC_API_KEY, else VLM iff READER_API_KEY) | claude | vlm | mock
READER_TIMEOUT_S=7.0                    # per attempt, capped by the deadline (Sail Gemma asap calls take ~3.1 s)
READER_HEDGE_S=3.25                     # primary not done by then -> fallback model runs in parallel, first answer wins
READER_DEADLINE_S=7.0                   # wall budget for all attempts (hedge + ~3.25 s + margin), then captions-only
READER_MAX_IMAGES=12                    # per call (Sail cap 20; <=12 keeps latency down); more tokens are chunked + merged
READER_THUMB_MAX_PX=512                 # thumbnails downscaled before base64
READER_FULL_IMAGES=6                    # Claude reader: the best N hits at READER_THUMB_MAX_PX, the rest at READER_SMALL_PX; 0 = all full size
READER_SMALL_PX=512                     # long side for the other hits (~262 vs ~922 Claude image tokens at 960); 0 = captions only for them
READER_VLM_SMALL_PX=0                   # VLM reader: 0 = every image at READER_THUMB_MAX_PX; >0 = hits beyond READER_FULL_IMAGES at this size
READER_MAX_TOKENS=256                   # cap on the reader's one-line JSON reply (~60-170 tokens); a cut reply retries, then captions-only
READER_JSON_MODE=schema                 # schema | object | off; downgraded automatically on HTTP 400
READER_COMPLETION_WINDOW=               # Sail: asap (default) | balanced -> X-Sail-Completion-Window header
READER_SKIP_ON_OCR=true                 # Claude path: no VLM call when every query keyword is in a top hit's OCR text
READER_EXTRA_BODY=                      # e.g. {"chat_template_kwargs":{"enable_thinking":false}} for vLLM Qwen3
ENRICH_PROVIDER=auto                    # auto (vlm iff a key is set, else local with IMAGE_EMBED_PROVIDER=openclip,
                                        # else mock) | vlm | local (SigLIP label + tesseract OCR, keyless) | mock
ENRICH_BASE_URL=                        # defaults to READER_BASE_URL (and its key / extra body / completion window)
ENRICH_MODEL=                           # defaults to READER_MODEL
ENRICH_API_KEY=                         # defaults to READER_API_KEY when ENRICH_BASE_URL is empty
ENRICH_TIMEOUT_S=20                     # per attempt; 1 retry on 429/5xx/timeout, then the local (or empty) fallback

# --- Embeddings ---
EMBED_PROVIDER=openai          # openai | voyage | local | mock
EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=
VOYAGE_API_KEY=
EMBED_DIM=1024                 # frozen per LanceDB table: purge / fresh LANCEDB_PATH after changing
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5   # EMBED_PROVIDER=local: keyless CPU (.[local-embeddings]); 384-d, fresh table
IMAGE_EMBED_PROVIDER=none      # none | mock | openclip (pip install -e ".[local-embeddings]" + CPU torch)
IMAGE_EMBED_MODEL=ViT-B-16-SigLIP
IMAGE_EMBED_PRETRAINED=webli
SEARCH_CALIBRATE_IMAGE=true    # SigLIP only: image hits count by match probability, so weak photos can't outrank text

# --- Speech ---
STT_PROVIDER=openai            # openai | deepgram | faster-whisper (keyless, as AUDIO_STT_*) | mock
STT_MODEL=gpt-transcribe            # openai: whisper-1 | gpt-4o-mini-transcribe ; deepgram: nova-2
TTS_PROVIDER=openai            # openai | elevenlabs | mock
TTS_MODEL=gpt-4o-mini-tts                # openai: tts-1 | gpt-4o-mini-tts ; elevenlabs: eleven_turbo_v2_5
TTS_VOICE=alloy                # openai voice name, or an ElevenLabs voice id
TTS_STREAM=true                # /chat/stream speaks each sentence as Claude finishes it (`audio` events)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# ambient audio (POST /v1/audio): empty = openai (whisper-1 segments) when STT_PROVIDER=openai + key, else the chat STT
AUDIO_STT_PROVIDER=            # "" | mock | openai | faster-whisper (pip install -e ".[local-stt]" + ffmpeg)
AUDIO_STT_MODEL=               # "" -> whisper-1 / small.en (faster-whisper; base.en or tiny.en are faster)
AUDIO_WINDOW_S=15              # transcript segments merged into memory tokens spanning <= this many seconds
AUDIO_ENHANCE=true             # band-pass 80-3800 Hz + loudnorm before local whisper (helps headset mics)
SPEECH_MERGE_S=10              # speech starting <= N s after the last transcript token ends continues it ...
SPEECH_MAX_TOKEN_S=60          # ... while the token spans <= N s
SPEECH_LINK_S=15               # retrieval: a transcript hit brings the nearest frame within +-N s, and vice versa (0 = off)

# --- Storage ---
STORE_BACKEND=memory           # memory | lancedb
RETRIEVER_BACKEND=hybrid       # hybrid | combo (per question: hybrid / UCC / hier) | ucc (Universal Constructor) | hier (LLM block/hour/day notes + 2-stage
                               # rerank over hybrid; +2 chat calls/query; both fall back to hybrid on error)
HIER_MODEL=gpt-4.1-mini        # hier: picks the 10-min blocks at recall time (stage 1)
HIER_RANK_MODEL=gpt-4.1        # hier: ranks the frame tokens in those blocks (stage 2); "" -> HIER_MODEL
HIER_REASONING_EFFORT=low      # only for reasoning models (gpt-5*/o*): minimal | none | low | ... (per model)
HIER_TIMEOUT_S=8               # hier: wall bound per recall (notes + pick + rank), then the hybrid's answer; 0 = off
HIER_CALL_TIMEOUT_S=4          # hier: per recall-time chat call
HIER_RETRIES=2                 # hier: attempts per recall-time chat call
HIER_NOTE_MODEL=gpt-4.1-mini   # hier: writes the 10-min block notes and hour/day rollups (once per block)
HIER_BASE_URL=https://api.openai.com/v1
HIER_API_KEY=                  # "" -> OPENAI_API_KEY
HIER_CACHE_PATH=./data/hier_notes.json
HIER_REFRESH_S=300             # background note refresh in the server (0 = only write notes at query time)
UCC_API_KEY=
UCC_CORPUS=megamind
UCC_TIMEOUT_S=4
LANCEDB_PATH=./data/lancedb
LANCEDB_VECTOR_DTYPE=float16   # float16 (half the bytes, same nearest neighbours) | float32; new tables only
THUMB_DIR=./data/thumbs
AUDIO_DIR=./data/audio
# media tiers: hot JPEG -> cold AV1 chunk per episode -> text only (needs ffmpeg with libsvtav1 or libaom-av1;
# without one frames stay JPEG and GET /v1/stats shows media.encoder=null)
CHUNK_DIR=                      # default <THUMB_DIR>/../chunks
HOT_RETENTION_H=72              # JPEG this long, then re-encoded into AV1 chunks
COLD_RETENTION_DAYS=100         # then pixels dropped (caption/OCR/vectors kept; thumb_url becomes "")
COLD_WIDTH=960
COLD_CRF=50
MEDIA_AGE_INTERVAL_S=3600       # background aging pass (0 = off; POST /v1/admin/age runs one now)

# --- Privacy ---
PRIVACY_BLUR_FACES=false        # blur bystander faces in stored thumbnails (= what the headset shows and the reader VLM
                                # sees). Needs OpenCV: pip install -e ".[privacy]"; without it: warning, no blur
PRIVACY_BLUR_FACES_VLM=false    # also blur the frame sent to the caption VLM / image embedder (implies the above)

# --- Filter ---
FILTER_MIN_GAP_S=2.0
FILTER_DHASH_MAX_DISTANCE=6
FILTER_DHASH_WINDOW_S=30
FILTER_MIN_LUMA=20
FILTER_MIN_SHARPNESS=40         # variance of Laplacian @320px; lower = keep blurrier frames
FILTER_HEARTBEAT_S=30           # always keep one frame per N s (0 = off)
FILTER_POSE_YAW_DEG=20          # keep when head turned >= N deg since last kept (0 = off)
FILTER_POSE_MOVE_M=0.5          # keep when head moved >= N m since last kept (0 = off)
FILTER_MAX_PER_MIN=20           # per-device cap on kept frames (0 = off)

# --- Moment replay (GET /v1/replay.mp4; needs ffmpeg on PATH or pip install -e ".[replay]") ---
REPLAY_ENABLED=true
REPLAY_WINDOW_S=900             # keep every received frame for ~15 min per device ...
REPLAY_MAX_FRAMES=9000          # ... bounded by count ...
REPLAY_MAX_BYTES=268435456      # ... and bytes (per device)
REPLAY_MAX_DEVICES=8            # least recently fed device dropped beyond this
REPLAY_SPOOL_DIR=               # e.g. ./data/replay_spool to keep frames on disk instead of RAM
REPLAY_MAX_SPAN_S=300           # longest clip one request may render
REPLAY_FFMPEG=                  # explicit ffmpeg binary (default: PATH, then imageio-ffmpeg)
REPLAY_BLUR_CACHE_BYTES=67108864 # face-blurred frame copies reused across clips (PRIVACY_BLUR_FACES)

# --- Real headset video (POST /v1/video from headset-android; replay + montage prefer it; same ffmpeg as replay) ---
VIDEO_ENABLED=true
VIDEO_STORE_DIR=                # default <THUMB_DIR>/../video
VIDEO_RETENTION_H=              # default HOT_RETENTION_H (real video is hot media; dropped when keyframes go cold)
VIDEO_MAX_BYTES=21474836480     # whole store (20 GB); oldest clips dropped beyond it
VIDEO_MAX_CLIP_BYTES=33554432   # per upload (a 5 s Quest clip is ~2 MB)
VIDEO_MAX_CLIP_S=60             # per upload
VIDEO_MIN_COVERAGE=0.5          # use video when it covers >= this share of a replay window / montage clip
VIDEO_REPLAY_FPS=30             # replay clips cut from video (montage uses MONTAGE_FPS)

# --- Live short-term memory (NOW items for "right now / just now" questions; uses the replay buffer) ---
LIVE_MEMORY_ENABLED=true
LIVE_MEMORY_FRAMES=3                 # newest raw frames shown to the reader as NOW-1..n ...
LIVE_MEMORY_FRAME_GAP_S=1.0          # ... at least this far apart
LIVE_MEMORY_MAX_AGE_S=120            # newest frame older than this vs. now -> not "now" (0 = no check)
LIVE_MEMORY_TRANSCRIPTS=2            # newest ambient-audio transcript tokens ...
LIVE_MEMORY_TRANSCRIPT_WINDOW_S=30   # ... from the last N seconds
# --- Montage (POST /v1/montage -> GET /v1/montages/{id}.mp4; same ffmpeg as replay) ---
MONTAGE_ENABLED=true
MONTAGE_PLANNER=auto            # auto (Claude iff ANTHROPIC_API_KEY) | claude | offline
MONTAGE_MAX_CLIPS=8
MONTAGE_CLIP_S=4                # default clip length (planner may pick 2.5-6 s)
MONTAGE_TIMELAPSE_STEP_S=1      # no buffered frames: stored keyframes held this long each (~1 fps timelapse)
MONTAGE_FONT=                   # TTF for captions (default: a system font, else fontconfig)
# content-filtered ("smart") montages: "montage of all shots of the guy in the black coat"
MONTAGE_SMART=auto              # auto (subject AND collection cue: "all/every ...", "shots of") | off (only mode="smart")
MONTAGE_VERIFIER=auto           # auto (Claude iff ANTHROPIC_API_KEY) | offline (unverified, retrieval order)
MONTAGE_VERIFY_MODEL=claude-haiku-5-5
MONTAGE_VERIFY_BATCH=8          # thumbnails per verifier call
MONTAGE_SMART_MAX_CANDIDATES=60
MONTAGE_SMART_MAX_CLIPS=12
MONTAGE_MOMENT_GAP_S=90         # matches closer than this are one moment (one clip)
# Photo montage (collage): POST /v1/collage + the chat agent's make_collage tool; reuses MONTAGE_VERIFY_* above
COLLAGE_ENABLED=true
COLLAGE_AGENT_TOOL=true         # offer make_collage to Claude ("show me pictures of ...", "make a collage of ...")
COLLAGE_MAX_IMAGES=9
COLLAGE_MOMENT_GAP_S=60         # matching photos closer than this are one moment (one tile)
COLLAGE_TILE_PX=360             # nominal photo width; rows are ~3/4 of it tall, photos keep their shape

# --- Memory Theater (static WebXR page at GET /xr; docs/quest3-guide.md) ---
XR_ENABLED=true

# --- Episodes / consolidation ---
EPISODE_GAP_S=120
EPISODE_SPLIT_SIM=0.70         # image cosine vs the mean of the last EPISODE_RECENT_N frames (SigLIP B/16)
EPISODE_REJOIN_SIM=0.80        # vs a recent episode's whole centroid, to rejoin it after a short detour
EPISODE_RECENT_N=6
EPISODE_MAX_S=1800             # split longer episodes so long stays still get summarised (0 = off)
EPISODE_MOVE_M=3.0             # split when the wearer is this far from the episode's pose centroid (0 = off)
CONSOLIDATE_ENABLED=true       # background job writing kind="episode" summary tokens
CONSOLIDATE_INTERVAL_S=600
CONSOLIDATE_MIN_TOKENS=3
SUMMARIZER_PROVIDER=mock       # mock | openai | anthropic
