<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  Megamind Quest 3 manifest.
  Based on the manifest generated by Meta XR Core SDK v85 (Meta > Tools > Update AndroidManifest.xml)
  for the Passthrough Camera API sample, plus the Megamind additions marked below.
  If you ever regenerate the manifest with the Meta menu, re-add the marked lines.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:installLocation="auto">
  <application android:label="@string/app_name" android:icon="@mipmap/app_icon" android:allowBackup="false"
               android:usesCleartextTraffic="true"> <!-- Megamind: plain-HTTP server over Tailscale / LAN -->
    <activity android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" android:configChanges="locale|fontScale|keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode" android:launchMode="singleTask" android:name="com.unity3d.player.UnityPlayerGameActivity" android:excludeFromRecents="true" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="com.oculus.intent.category.VR" />
      </intent-filter>
      <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
    </activity>
    <meta-data android:name="unityplayer.SkipPermissionsDialog" android:value="false" />
    <meta-data android:name="com.oculus.ossplash.background" android:value="passthrough-contextual" />
    <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s" tools:replace="android:value" />
  </application>
  <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
  <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="true" />
  <!-- Megamind: boundaryless MR app, so the wearer can walk between rooms without the boundary (Guardian) interrupting
       capture. Meta "Boundaryless Mode for Mixed Reality in Unity":
       https://developers.meta.com/horizon/documentation/unity/unity-boundaryless/
       Only applies to a standalone APK (not Link); mutually exclusive with the contextual Boundary API, so keep
       OculusProjectConfig boundaryVisibilitySupport = None and OVRManager.shouldBoundaryVisibilityBeSuppressed = false.
       Not generated by "Meta > Tools > Update AndroidManifest.xml": re-add it after regenerating. -->
  <uses-feature android:name="com.oculus.feature.BOUNDARYLESS_APP" android:required="true" />
  <uses-permission android:name="com.oculus.permission.USE_ANCHOR_API" />
  <uses-permission android:name="com.oculus.permission.USE_SCENE" />
  <!-- Passthrough Camera API (Horizon OS v74+). HEADSET_CAMERA is the one PassthroughCameraAccess checks and the one
       MegamindPermissions requests at runtime (via OVRPermissionsRequester, same as Meta's sample). android.permission.CAMERA
       is declared too; it is never requested at runtime, so only one dialog appears.
       NOTE: "Meta > Tools > Update AndroidManifest.xml" regenerates this file and drops HEADSET_CAMERA — re-add it. -->
  <uses-permission android:name="horizonos.permission.HEADSET_CAMERA" />
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- Megamind: upload frames / chat with the server, push-to-talk microphone -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Megamind: hand tracking (index pinch = push-to-talk, middle pinch = capture toggle), controllers still work.
       Matches OVRProjectConfig "Hand Tracking Support = Controllers And Hands" (set by Megamind > 1). -->
  <uses-feature android:name="oculus.software.handtracking" android:required="false" />
  <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
</manifest>
