# python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
server/.env
server/data/
# benchmark datasets / reports (downloaded at runtime; COCO, Flickr and EgoLife licences forbid committing them)
bench_data/
egolife_data/
*.bench.json

# latex
docs/*.aux docs/*.log docs/*.out docs/*.toc docs/*.fls docs/*.fdb_latexmk docs/*.synctex.gz

# os / editors
.DS_Store
.idea/
.vscode/

server/.eval_cache/
server/.eval_cache_ucc/
server/.eval_cache_*/

# secrets / local data
.env
.env.*
!.env.example
/data/

# Unity (headset/Megamind also has its own .gitignore)
[Ll]ibrary/
[Tt]emp/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.csproj
*.sln
!headset/tests/**/*.csproj

# Android / builds
*.apk
*.aab

# node
node_modules/
